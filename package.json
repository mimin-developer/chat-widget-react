{
  "name": "chatkit-widgets",
  "description": "Embeddable chat widgets for websites, starting with the omnichannel web chat (OmniWidget)",
  "keywords": [
    "chat-widget",
    "omnichannel",
    "widget",
    "web-chat",
    "react"
  ],
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimin-developer/chat-widget-react.git"
  },
  "homepage": "https://github.com/mimin-developer/chat-widget-react#readme",
  "bugs": {
    "url": "https://github.com/mimin-developer/chat-widget-react/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-css.mjs && tsc -p tsconfig.build.json",
    "build:hosted": "npm run build && node scripts/copy-to-host.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/types/widget.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/widget.d.ts",
      "import": "./dist/omnichannel.js"
    }
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.435.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
